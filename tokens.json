{
	"$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
	"$description": "A Google Material Design 3 (M3) styled design system for converting Markdown into Bitrix24 compatible BBCode and HTML previews.",
	"color": {
		"$type": "color",
		"primary": {
			"$value": {
				"colorSpace": "srgb",
				"components": [0.043, 0.341, 0.816],
				"hex": "#0b57d0"
			}
		},
		"primary-hover": {
			"$value": {
				"colorSpace": "srgb",
				"components": [0.031, 0.259, 0.627],
				"hex": "#0842a0"
			}
		},
		"secondary": {
			"$value": {
				"colorSpace": "srgb",
				"components": [0.267, 0.278, 0.275],
				"hex": "#444746"
			}
		},
		"tertiary": {
			"$value": {
				"colorSpace": "srgb",
				"components": [0.102, 0.451, 0.91],
				"hex": "#1a73e8"
			}
		},
		"success": {
			"$value": {
				"colorSpace": "srgb",
				"components": [0.075, 0.451, 0.2],
				"hex": "#137333"
			}
		},
		"success-hover": {
			"$value": {
				"colorSpace": "srgb",
				"components": [0.059, 0.322, 0.137],
				"hex": "#0f5223"
			}
		},
		"neutral": {
			"$value": {
				"colorSpace": "srgb",
				"components": [0.973, 0.976, 0.98],
				"hex": "#f8f9fa"
			}
		},
		"surface": {
			"$value": {
				"colorSpace": "srgb",
				"components": [1, 1, 1],
				"hex": "#ffffff"
			}
		},
		"surface-variant": {
			"$value": {
				"colorSpace": "srgb",
				"components": [0.882, 0.89, 0.882],
				"hex": "#e1e3e1"
			}
		},
		"text-dark": {
			"$value": {
				"colorSpace": "srgb",
				"components": [0.122, 0.122, 0.122],
				"hex": "#1f1f1f"
			}
		}
	},
	"spacing": {
		"$type": "dimension",
		"xs": {
			"$value": {
				"value": 4,
				"unit": "px"
			}
		},
		"sm": {
			"$value": {
				"value": 8,
				"unit": "px"
			}
		},
		"md": {
			"$value": {
				"value": 12,
				"unit": "px"
			}
		},
		"lg": {
			"$value": {
				"value": 16,
				"unit": "px"
			}
		},
		"xl": {
			"$value": {
				"value": 24,
				"unit": "px"
			}
		}
	},
	"rounded": {
		"$type": "dimension",
		"sm": {
			"$value": {
				"value": 8,
				"unit": "px"
			}
		},
		"md": {
			"$value": {
				"value": 12,
				"unit": "px"
			}
		},
		"lg": {
			"$value": {
				"value": 16,
				"unit": "px"
			}
		},
		"xl": {
			"$value": {
				"value": 28,
				"unit": "px"
			}
		},
		"full": {
			"$value": {
				"value": 9999,
				"unit": "px"
			}
		}
	},
	"typography": {
		"h1": {
			"$type": "typography",
			"$value": {
				"fontFamily": "'Google Sans', Roboto, system-ui, -apple-system, sans-serif",
				"fontSize": {
					"value": 1.25,
					"unit": "rem"
				},
				"fontWeight": 500,
				"lineHeight": 1.2
			}
		},
		"h2": {
			"$type": "typography",
			"$value": {
				"fontFamily": "'Google Sans', Roboto, system-ui, -apple-system, sans-serif",
				"fontSize": {
					"value": 1.1,
					"unit": "rem"
				},
				"fontWeight": 500,
				"lineHeight": 1.3
			}
		},
		"body-md": {
			"$type": "typography",
			"$value": {
				"fontFamily": "Roboto, system-ui, -apple-system, sans-serif",
				"fontSize": {
					"value": 0.875,
					"unit": "rem"
				},
				"lineHeight": 1.5
			}
		},
		"body-sm": {
			"$type": "typography",
			"$value": {
				"fontFamily": "Roboto, system-ui, -apple-system, sans-serif",
				"fontSize": {
					"value": 0.75,
					"unit": "rem"
				},
				"lineHeight": 1.4
			}
		},
		"code": {
			"$type": "typography",
			"$value": {
				"fontFamily": "'Roboto Mono', monospace",
				"fontSize": {
					"value": 0.875,
					"unit": "rem"
				}
			}
		}
	}
}
